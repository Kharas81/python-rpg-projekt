// src/config/settings.json5
{
  // Globale Spieleinstellungen
  "game_settings": {
    "min_damage": 1,
    "base_weapon_damage": 5,
    "hit_chance_base": 90,
    "hit_chance_accuracy_factor": 3,
    "hit_chance_evasion_factor": 2,
    "hit_chance_min": 5,
    "hit_chance_max": 95,
    "xp_level_base": 100,
    "xp_level_factor": 1.5,
    // NEU für V6 Execute-Skills
    "execute_skill_hp_threshold_percent": 0.25, // Gegner HP müssen unter 25% sein
    "execute_skill_default_damage": 35         // Standard-Schaden für Execute-Skills (falls nicht im Skill anders definiert)
  },
  // Logging Einstellungen
  "logging_settings": {
    "log_level": "INFO", 
    "log_file": "logs/rpg_app.txt", 
    "log_to_console": true,
    "log_to_file": true,
    "log_format_verbose": "%(asctime)s - %(name)s - %(levelname)s - [%(module)s.%(funcName)s:%(lineno)d] - %(message)s",
    "log_format_simple": "%(asctime)s [%(levelname)s][%(name)s]: %(message)s",
    "date_format": "%Y-%m-%d %H:%M:%S",
    "date_format_console": "%H:%M:%S"
  },
  // RL-Ausgabeeinstellungen
  "rl_output_settings": {
    "console_verbosity_during_training": "minimal", 
    "force_disable_rich_colors_in_rl_console": true 
  },
  // RL-Systemeinstellungen (globale Defaults, werden von Setup-Dateien überschrieben)
  "rl_settings": {
    "agent_type": "PPO", 
    "learning_rate": 0.0003,
    "gamma": 0.99
  }
}